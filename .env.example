# Cổng chạy demo.
PORT=4000

# Origin công khai của trang demo. Phải nằm trong allowedOrigins của nền tảng
# (OAuth client) đã bật Widget connect, nếu không widget sẽ không nhúng được.
# Chạy local thì để http://localhost:4000 và khai origin này cho client sandbox.
PUBLIC_URL=http://localhost:4000

# Sandbox. Production: https://api.gpmpay.com và https://widget-connect.gpmpay.com/v1/connect.js
GPMPAY_API_URL=https://sandbox-api.gpmpay.com
WIDGET_SCRIPT_URL=https://sandbox-widget-connect.gpmpay.com/v1/connect.js

# Hiện nút "Giả lập đã thanh toán" ở tab Thanh toán (bill lẻ và bill gộp).
# Backend phải bật PARTNER_BILL_SIMULATION_ENABLED=true, nếu không nút trả 404.
# Không bao giờ bật khi trỏ vào production.
PAYMENT_SIMULATION=true

# API token đối tác (gpm_...) tạo ở trang API tokens: chọn nền tảng (Widget
# connect) và tick các scope partner:*. Token chỉ nằm ở server, không bao giờ
# gửi xuống trình duyệt.
GPMPAY_PARTNER_TOKEN=

# Secret HMAC của webhook tự tạo khi kết nối. GPMPay ký payload bằng secret này,
# demo kiểm chữ ký header X-GPMPay-Signature. Tối thiểu 16 ký tự.
WEBHOOK_SECRET=doi-secret-nay-cho-dai-va-ngau-nhien
